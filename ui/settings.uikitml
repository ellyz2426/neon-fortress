<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="420" flex-direction="column" gap="12" align-items="center">
    <div font-size="24" font-weight="bold" color="#00ffff">SETTINGS</div>
    <div height="6"></div>
    <div font-size="14" color="#888888">Color Scheme</div>
    <div flex-direction="row" gap="8">
      <div name="btn-color-cyan" background-color="#00aaaa" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#ffffff">Cyan</div>
      </div>
      <div name="btn-color-green" background-color="#00aa44" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#ffffff">Green</div>
      </div>
      <div name="btn-color-magenta" background-color="#aa44aa" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#ffffff">Magenta</div>
      </div>
      <div name="btn-color-gold" background-color="#aa8800" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#ffffff">Gold</div>
      </div>
    </div>
    <div height="8"></div>
    <div name="btn-settings-back" background-color="#444444" border-radius="8" padding="10" width="180" align-items="center" cursor="pointer">
      <div font-size="14" color="#aaaaaa">Back</div>
    </div>
  </div>
</panel>
