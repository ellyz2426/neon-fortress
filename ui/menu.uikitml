<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="500" flex-direction="column" gap="12" align-items="center">
    <div font-size="36" font-weight="bold" color="#00ffff">NEON FORTRESS</div>
    <div font-size="14" color="#888888">Isometric Space Fortress Assault</div>
    <div height="8"></div>
    <div name="btn-play" background-color="#00aaaa" border-radius="8" padding="12" width="280" align-items="center" hover-background-color="#00cccc" cursor="pointer">
      <div font-size="20" font-weight="bold" color="#000000">START MISSION</div>
    </div>
    <div height="4"></div>
    <div font-size="12" color="#888888">Game Mode</div>
    <div flex-direction="row" gap="6">
      <div name="btn-mode-arcade" background-color="#00aaaa" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Arcade</div>
      </div>
      <div name="btn-mode-speed" background-color="#333333" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Speed</div>
      </div>
      <div name="btn-mode-zen" background-color="#333333" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Zen</div>
      </div>
      <div name="btn-mode-challenge" background-color="#333333" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Challenge</div>
      </div>
    </div>
    <div font-size="12" color="#888888">Difficulty</div>
    <div flex-direction="row" gap="6">
      <div name="btn-diff-normal" background-color="#00aaaa" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Normal</div>
      </div>
      <div name="btn-diff-hard" background-color="#333333" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Hard</div>
      </div>
      <div name="btn-diff-insane" background-color="#333333" border-radius="6" padding="8" padding-left="12" padding-right="12" cursor="pointer">
        <div font-size="12" color="#ffffff">Insane</div>
      </div>
    </div>
    <div height="4"></div>
    <div flex-direction="row" gap="8">
      <div name="btn-settings" background-color="#444444" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#aaaaaa">Settings</div>
      </div>
      <div name="btn-stats" background-color="#444444" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#aaaaaa">Stats</div>
      </div>
      <div name="btn-tutorial" background-color="#444444" border-radius="6" padding="8" padding-left="14" padding-right="14" cursor="pointer">
        <div font-size="12" color="#aaaaaa">How to Play</div>
      </div>
    </div>
  </div>
</panel>
