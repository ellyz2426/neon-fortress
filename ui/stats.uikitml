<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="440" flex-direction="column" gap="6" align-items="center">
    <div font-size="24" font-weight="bold" color="#00ffff">CAREER STATS</div>
    <div height="4"></div>
    <div name="stat-highscore" font-size="16" color="#ffcc00">High Score: 0</div>
    <div flex-direction="row" justify-content="space-between" width="380">
      <div flex-direction="column" gap="4">
        <div name="stat-games" font-size="13" color="#aaaaaa">Games: 0</div>
        <div name="stat-kills" font-size="13" color="#aaaaaa">Kills: 0</div>
        <div name="stat-fuel" font-size="13" color="#aaaaaa">Fuel: 0</div>
        <div name="stat-shots" font-size="13" color="#aaaaaa">Shots: 0</div>
        <div name="stat-powerups" font-size="13" color="#aaaaaa">Power-ups: 0</div>
        <div name="stat-bosses" font-size="13" color="#aaaaaa">Bosses: 0</div>
        <div name="stat-asteroids" font-size="13" color="#8888aa">Asteroids: 0</div>
      </div>
      <div flex-direction="column" gap="4">
        <div name="stat-combo" font-size="13" color="#aaaaaa">Best Combo: x0</div>
        <div name="stat-distance" font-size="13" color="#aaaaaa">Distance: 0m</div>
        <div name="stat-missiles" font-size="13" color="#44ffaa">Missiles: 0</div>
        <div name="stat-checkpoints" font-size="13" color="#44ff44">Checkpoints: 0</div>
        <div name="stat-ground" font-size="13" color="#ff8800">Ground Tgts: 0</div>
        <div name="stat-formations" font-size="13" color="#ffcc00">Formations: 0</div>
        <div name="stat-cloakers" font-size="13" color="#4488ff">Cloakers: 0</div>
        <div name="stat-bombs" font-size="13" color="#ff4444">Smart Bombs: 0</div>
      </div>
    </div>
    <div height="6"></div>
    <div name="btn-stats-back" background-color="#444444" border-radius="8" padding="10" width="180" align-items="center" cursor="pointer">
      <div font-size="14" color="#aaaaaa">Back</div>
    </div>
  </div>
</panel>
