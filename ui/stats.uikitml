<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="420" flex-direction="column" gap="8" align-items="center">
    <div font-size="24" font-weight="bold" color="#00ffff">CAREER STATS</div>
    <div height="6"></div>
    <div name="stat-highscore" font-size="16" color="#ffcc00">High Score: 0</div>
    <div name="stat-games" font-size="14" color="#aaaaaa">Games Played: 0</div>
    <div name="stat-kills" font-size="14" color="#aaaaaa">Total Kills: 0</div>
    <div name="stat-fuel" font-size="14" color="#aaaaaa">Total Fuel: 0</div>
    <div name="stat-shots" font-size="14" color="#aaaaaa">Total Shots: 0</div>
    <div name="stat-powerups" font-size="14" color="#aaaaaa">Power-ups: 0</div>
    <div name="stat-bosses" font-size="14" color="#aaaaaa">Bosses Beaten: 0</div>
    <div name="stat-combo" font-size="14" color="#aaaaaa">Best Combo: x0</div>
    <div name="stat-distance" font-size="14" color="#aaaaaa">Total Distance: 0m</div>
    <div height="8"></div>
    <div name="btn-stats-back" background-color="#444444" border-radius="8" padding="10" width="180" align-items="center" cursor="pointer">
      <div font-size="14" color="#aaaaaa">Back</div>
    </div>
  </div>
</panel>
