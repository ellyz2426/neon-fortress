<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="400" flex-direction="column" gap="12" align-items="center">
    <div font-size="28" font-weight="bold" color="#ffcc00">PAUSED</div>
    <div height="8"></div>
    <div name="btn-resume" background-color="#00aaaa" border-radius="8" padding="12" width="220" align-items="center" cursor="pointer">
      <div font-size="18" font-weight="bold" color="#000000">Resume</div>
    </div>
    <div name="btn-quit" background-color="#884444" border-radius="8" padding="12" width="220" align-items="center" cursor="pointer">
      <div font-size="18" font-weight="bold" color="#ffffff">Quit</div>
    </div>
  </div>
</panel>
