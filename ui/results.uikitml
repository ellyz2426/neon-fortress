<panel>
  <div background-color="#000000cc" border-radius="16" padding="24" width="440" flex-direction="column" gap="10" align-items="center">
    <div font-size="28" font-weight="bold" color="#ff4444">MISSION OVER</div>
    <div height="6"></div>
    <div name="result-score" font-size="22" font-weight="bold" color="#00ffff">Final Score: 0</div>
    <div name="result-high" font-size="14" color="#ffcc00">High Score: 0</div>
    <div height="4"></div>
    <div name="result-level" font-size="14" color="#aaaaaa">Level Reached: 1</div>
    <div name="result-kills" font-size="14" color="#aaaaaa">Enemies Destroyed: 0</div>
    <div name="result-combo" font-size="14" color="#aaaaaa">Best Combo: x0</div>
    <div name="result-distance" font-size="14" color="#aaaaaa">Distance: 0m</div>
    <div height="8"></div>
    <div name="btn-retry" background-color="#00aaaa" border-radius="8" padding="12" width="220" align-items="center" cursor="pointer">
      <div font-size="18" font-weight="bold" color="#000000">Retry</div>
    </div>
    <div name="btn-menu" background-color="#444444" border-radius="8" padding="10" width="220" align-items="center" cursor="pointer">
      <div font-size="16" color="#aaaaaa">Main Menu</div>
    </div>
  </div>
</panel>
